# The releng line: BSDnas on a FreeBSD release branch. A build is named after
# the FreeBSD version it is built on (BSDnas-15.1-...), and it gets a train of
# its own (BSDnas-15.1-Nightlies), so systems of the stable line (BSDnas-15)
# are never offered a releng build and the other way round.
#
# Everything except the values below is shared with the freenas profile: the
# other files of this directory are links to it.
include("../freenas/env.pyd")

VERSION_NUMBER = "15.1"
FREEBSD_RELEASE_VERSION = "15.1-RELEASE"
OS_BRANCH = "base/releng-15.1"
PROFILE_DESCRIPTION = "BSDnas on FreeBSD releng/15.1"
