# Гостевые дополнения VMware и Xen не собираются на FreeBSD 15 текущим clang:
# open-vm-tools падает на неявном int (`type specifier missing, defaults to
# int`), который в C23 стал ошибкой, xe-guest-utilities — на -Werror для
# неиспользованного аргумента командной строки. Это дефекты самих портов
# в ветке 2026Q2, не нашей сборки.
# Потеря заметна только при установке в VMware или Xen: пропадает синхронизация
# времени и корректное завершение работы по команде гипервизора. Проверить
# заново при переходе на 2026Q3.
# ports += {
#     "name": "emulators/open-vm-tools@nox11",
#     "package": "open-vm-tools-nox11",
# }
# ports += "sysutils/xe-guest-utilities"
ports += "databases/sqlite3"
ports += {
    "name": "databases/py-alembic",
    "options": [
	    "OPTIONS_FILE_SET+=SQLALCHEMY14",
	    "OPTIONS_FILE_UNSET+=SQLALCHEMY20"
    ]
}
