# lsof включает ядерные заголовки в пользовательском коде, а в sys/systm.h
# на FreeBSD 15 поменялись типы (copyright, asprintf, vasprintf) — порт не
# собирается. В базовой системе есть fstat(1), sockstat(1) и procstat(1),
# закрывающие те же задачи. Проверить заново при переходе на 2026Q3.
# ports += "sysutils/lsof"
