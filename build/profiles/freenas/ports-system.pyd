# Проприетарные CLI для аппаратных RAID отключены: distfiles исчезли у вендоров.
# arcconf_B25611.zip — 404 и у Adaptec, и в distcache.FreeBSD.org;
# 8-07-14_MegaCLI.zip — 404 в distcache, у Broadcom страница переехала.
# Из-за этого падала вся сборка портов. tw_cli poudriere и так помечает Ignored.
# Ни один порт от них не зависит, в middleware ссылок нет — это просто
# доукомплектование образа утилитами. Для NAS на ZFS аппаратный RAID и так
# противопоказан. Если понадобятся — хостить distfiles у себя и вернуть строки.
# ports += "sysutils/arcconf"
# ports += "sysutils/tw_cli"
# ports += "sysutils/megacli"
ports += "truenas/areca-cli"
ports += "sysutils/hptcli"
