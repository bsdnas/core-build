repos += {
    "name": "os",
    "path": "os",
    "url": "https://github.com/bsdnas/os.git",
    "branch": "base/stable-15"
}

repos += {
    "name": "freenas",
    "path": "freenas",
    "url": "https://github.com/bsdnas/middleware.git",
    "branch": "bsdnas"
}


repos += {
    "name": "webui",
    "path": "webui",
    "url": "https://github.com/bsdnas/webui.git",
    "branch": "truenas/13.3-stable"
}

# Дерево портов намеренно НЕ форкается: берётся квартальная ветка апстрима
# FreeBSD и поверх накладывается overlay nas_ports из middleware. Собственный
# форк ports был у iX главным источником гниения — из него вычищать изменения
# дороже, чем раз в квартал переезжать на новую ветку.
repos += {
    "name": "ports",
    "path": "ports",
    "url": "https://github.com/freebsd/freebsd-ports.git",
    "branch": "2026Q2"
}

repos += {
    "name": "freenas-pkgtools",
    "path": "freenas-pkgtools",
    "url": "https://github.com/bsdnas/pkgtools.git",
    "branch": "master"
}

repos += {
    "name": "py-bsd",
    "path": "py-bsd",
    "url": "https://github.com/bsdnas/py-bsd.git",
    "branch": "master"
}

repos += {
    "name": "iocage",
    "path": "iocage",
    "url": "https://github.com/bsdnas/iocage.git",
    "branch": "truenas/13.0-u6.3-stable"
}
