MILESTONE = MILESTONE or "MASTER"
FREEBSD_RELEASE_VERSION = "15.0-RELEASE"
VERSION_NUMBER = "15"
# The FreeBSD base this line is built on. The releng profiles reuse every
# other file of this profile and differ only in these values, so the branch
# is a variable rather than a literal in repos.pyd.
OS_BRANCH = "base/stable-15"
PROFILE_DESCRIPTION = "BSDnas on FreeBSD stable/15"
FREENAS_ROOT = "${BE_ROOT}/freenas"
SRC_ROOT = "${FREENAS_ROOT}/src"

CHANGELOG = CHANGELOG or "${BUILD_ROOT}/release/FreeNAS/11/RELEASE/ChangeLog"

if exists("${FREENAS_ROOT}"):
    GIT_REVISION = sh("git -C ${FREENAS_ROOT} rev-parse --verify --short HEAD")

FREENAS_KEYFILE = FREENAS_KEYFILE or "Keys/ix-nightly-key.key"
