# The releng line: BSDnas on a FreeBSD release branch. A build is named after
# the FreeBSD version it is built on (BSDnas-15.2-...), and it gets a train of
# its own (BSDnas-15.2-Nightlies), so systems of the other lines are never
# offered a build of this one and the other way round.
#
# Everything except the values below is shared with the freenas profile: the
# other files of this directory are links to it.
include("../freenas/env.pyd")

VERSION_NUMBER = "15.2"
# releng/15.2 is still at its release candidates: this follows BRANCH in
# sys/conf/newvers.sh of OS_BRANCH (RC1, RC2, ... RELEASE).
FREEBSD_RELEASE_VERSION = "15.2-RC1"
OS_BRANCH = "base/releng-15.2"
PROFILE_DESCRIPTION = "BSDnas on FreeBSD releng/15.2"
